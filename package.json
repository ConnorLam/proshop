{
  "name": "proshop",
  "version": "1.0.0",
  "description": "eCommerce application built with the MERN stack",
  "homepage": "https://github.com/ConnorLam/proshop#readme",
  "bugs": {
    "url": "https://github.com/ConnorLam/proshop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConnorLam/proshop.git"
  },
  "license": "MIT",
  "author": "Connor Lam",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
